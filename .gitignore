# Xcode's per-user scheme management — the schemes themselves are shared, but
# which ones are visible and in what order is a personal preference.
*.xcscmblueprint
*.xccheckout

# App Store Connect API keys — never in the repo.
*.p8

# Real recordings — riders' own GPS tracks. Fixtures for local test
# runs only; they are personal location data and must not be published.
testdata/

# Test recordings ride along with debug builds but are never committed.
openWater/DevSeed/*
!openWater/DevSeed/README.md
