<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Only the keys Xcode's INFOPLIST_KEY_* build settings will not produce.

	  UIBackgroundModes is silently dropped when supplied as
	  INFOPLIST_KEY_UIBackgroundModes, and without it CoreLocation raises an
	  exception the moment `allowsBackgroundLocationUpdates` is set — taking the
	  app down at launch. Everything else stays in the build settings, where it
	  is easier to keep in step with the watch target.
	-->
	<!--
	  Export compliance, answered here so every upload does not stop in
	  App Store Connect waiting for someone to tick a box.

	  "false" means the app uses no non-exempt encryption. openWater's only
	  network call is an HTTPS upload of a shared session; HTTPS is the standard
	  exemption, and there is no cryptography of our own anywhere in the app.
	  If that ever stops being true — a custom cipher, an encrypted local store —
	  this has to be revisited, because it is a legal declaration and not a
	  build setting.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<!--
	  The file types openWater opens, so a track arrives by tapping it rather
	  than by remembering the app has an import button.

	  A rider is sent a GPX in a message, or airdrops an export from another
	  phone, and the natural move is to tap it. Without this the system has no
	  idea openWater wants it: Files offers "Save", the share sheet has no entry,
	  and the only way in is Sessions → + → Import, which nobody discovers.

	  `.openwater` is ours, so it is *exported* — we define what the identifier
	  means. GPX is a public format nobody has standardised a UTI for, so it is
	  *imported* under a reverse-DNS name conforming to public.xml; several apps
	  declare it this way and the system reconciles them.
	-->

	<!--
	  Yes, we can read a file where it lies.

	  Declaring CFBundleDocumentTypes without this is what App Store Connect
	  warns about ("Missing Document Configuration"): having said the app opens
	  documents, it has to say whether it opens the original or wants a copy.

	  YES is the honest answer here, not just the recommended one. `onOpenURL`
	  takes the security-scoped URL, parses the track and builds a session from
	  it; nothing is written back to the file and nothing refers to it
	  afterwards. NO would have the system duplicate every incoming GPX into
	  our Inbox first — a pointless copy of a file we read once, and on a
	  three-hour FIT not a small one.

	  UISupportsDocumentBrowser is the other way to satisfy the warning and is
	  deliberately absent: it is for apps built around
	  UIDocumentBrowserViewController, which this is not.
	-->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>openWater Session</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.laan.labs.openwater.session</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>GPX Track</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.topografix.gpx</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Garmin FIT Activity</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.garmin.fit</string>
			</array>
		</dict>
	</array>

	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.laan.labs.openwater.session</string>
			<key>UTTypeDescription</key>
			<string>openWater Session</string>
			<!--
			  Data rather than JSON, though the contents are JSON.
			  Conforming to `public.json` is more truthful and makes Files
			  *preview* the file instead of handing it over: tapping a session
			  showed a rider a wall of raw braces. The file is only ever useful
			  inside the app, so it declares the conformance that gets it there.
			-->
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>openwater</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.openwater.session+json</string>
				</array>
			</dict>
		</dict>
	</array>

	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.topografix.gpx</string>
			<key>UTTypeDescription</key>
			<string>GPX Track</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>gpx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/gpx+xml</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.garmin.fit</string>
			<key>UTTypeDescription</key>
			<string>Garmin FIT Activity</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fit</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
