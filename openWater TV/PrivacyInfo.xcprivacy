<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Apple's privacy manifest. Required since May 2024, and its absence is
	  what App Store Connect warns about on upload (ITMS-91053).

	  The phone's manifest with one section removed, because the television
	  does one fewer thing:

	  - There are no third-party SDKs here either. The guide and the forecasts
	    are REST calls over URLSession — Firestore and Open-Meteo — so there is
	    no vendored framework carrying its own manifest and nothing here is
	    inherited.
	  - The only required-reason API used is UserDefaults, for the rider's own
	    favourites and their chosen forecast model.
	  - Nothing is uploaded. Sharing is a phone feature; an Apple TV records
	    nothing and has no account to attach anything to.
	  - Coarse location is declared, and only coarse. tvOS has no receiver:
	    what `requestLocation` hands over is a network-derived guess, used to
	    decide which stretch of coast the wind map opens on, and the map's
	    centre coordinate goes to Open-Meteo to ask what the wind is doing
	    there. That is the whole of it — no track, no history, nothing stored
	    off the device, and a rider who would rather type a place name than
	    be located gets the same app.
	  - There is no analytics, no advertising, no accounts and no tracking.
	-->

	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
			  Starred spots, their order, and the forecast model.
			  CA92.1: accessed only to read and write this app's own settings,
			  never written anywhere it could identify a device.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!--
			  The coordinate the map is centred on, sent to Open-Meteo for a
			  forecast. Coarse rather than precise: tvOS cannot be more exact
			  than a neighbourhood, and the map rounds to about a kilometre
			  before it asks.

			  Not linked to identity: there are no accounts here, and the
			  request carries nothing but a latitude and a longitude.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
